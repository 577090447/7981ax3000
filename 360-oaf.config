CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_libuv=y
CONFIG_PACKAGE_libwebsockets-full=y
CONFIG_PACKAGE_libxtables=y
# CONFIG_PACKAGE_libyaml=y  # 精简移除
CONFIG_PACKAGE_lua=y
##############################################################
# 11) OAF 应用过滤 —— 核心依赖
##############################################################
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
##############################################################
# 12) 网络应用插件 —— OpenClash / UPnP / tailscale / zerotier / turboacc / QoS
#     luci-app-turboacc-mtk 保留：按你要求，运行时再决定是否开启加速
#     mtkhqos_util 已关闭（与 OAF 争抢 nf_conn mark）
##############################################################
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_mtkhqos_util is not set       # 与 OAF 冲突：MTK HQoS 流量调度
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y        # 保留，运行时选择关闭以配合 OAF
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
##############################################################
# 13) 存储 / 文件系统插件 —— 外置存储支持
##############################################################
##############################################################
# 14) LuCI —— 应用插件 + 中文语言包
##############################################################
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_rtp2httpd=y
