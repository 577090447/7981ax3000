CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-iwinfo=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_ucode-mod-lua=y
##############################################################
# 17) 编译安全选项
##############################################################
CONFIG_PKG_FORTIFY_SOURCE_2=y
# CONFIG_RUBY_ENABLE_YJIT is not set
